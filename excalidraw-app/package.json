{
  "name": "excalidraw-app",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-sql": "2.6.0",
    "i18next-browser-languagedetector": "6.1.4",
    "jotai": "2.11.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "prettier": "@excalidraw/prettier-config",
  "scripts": {
    "build-node": "node ./scripts/build-node.js",
    "build:app": "cross-env VITE_APP_GIT_SHA=$GIT_SHA vite build",
    "build:tauri": "cross-env VITE_APP_GIT_SHA=$GIT_SHA vite build --mode tauri",
    "build:version": "node ../scripts/build-version.js",
    "build": "pnpm build:tauri && pnpm build:version",
    "start": "vite"
  }
}
