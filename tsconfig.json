{
  "compilerOptions": {
    "rootDir": "./",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@excalidraw/common": ["./excalidraw-app/lib/common/src/index.ts"],
      "@excalidraw/common/*": ["./excalidraw-app/lib/common/src/*"],
      "@excalidraw/excalidraw": ["./excalidraw-app/lib/excalidraw/index.tsx"],
      "@excalidraw/excalidraw/*": ["./excalidraw-app/lib/excalidraw/*"],
      "@excalidraw/excalidraw/common/*": ["./excalidraw-app/lib/common/src/*"],
      "@excalidraw/excalidraw/element/*": ["./excalidraw-app/lib/element/src/*"],
      "@excalidraw/element": ["./excalidraw-app/lib/element/src/index.ts"],
      "@excalidraw/element/*": ["./excalidraw-app/lib/element/src/*"],
      "@excalidraw/fractional-indexing": ["./excalidraw-app/lib/fractional-indexing/src/index.ts"],
      "@excalidraw/fractional-indexing/*": ["./excalidraw-app/lib/fractional-indexing/src/*"],
      "@excalidraw/laser-pointer": ["./excalidraw-app/lib/laser-pointer/src/index.ts"],
      "@excalidraw/laser-pointer/*": ["./excalidraw-app/lib/laser-pointer/src/*"],
      "@excalidraw/math": ["./excalidraw-app/lib/math/src/index.ts"],
      "@excalidraw/math/*": ["./excalidraw-app/lib/math/src/*"],
      "@excalidraw/utils": ["./excalidraw-app/lib/utils/src/index.ts"],
      "@excalidraw/utils/*": ["./excalidraw-app/lib/utils/src/*"]
    }
  },
  "include": ["excalidraw-app"],
  "exclude": ["excalidraw-app/build", "examples", "dist", "types", "tests"]
}
