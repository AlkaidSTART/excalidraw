{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-fs-write",
  "description": "Allow writing files chosen through the save dialog on desktop",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**/*" }, { "path": "$DESKTOP/**/*" }, { "path": "$DOCUMENT/**/*" }, { "path": "$DOWNLOAD/**/*" }, { "path": "$PICTURE/**/*" }]
    }
  ]
}
