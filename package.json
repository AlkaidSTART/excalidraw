    "radix-ui": "1.4.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "roughjs": "4.6.4",
    "sass": "1.51.0",
    "tinycolor2": "1.6.0",
    "tunnel-rat": "0.1.2"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@excalidraw/eslint-config": "1.0.3",
    "@excalidraw/prettier-config": "1.0.2",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.debounce": "4.0.8",
    "@types/lodash.throttle": "4.1.7",
    "@types/pako": "2.0.3",
    "@types/pica": "5.1.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/resize-observer-browser": "0.1.7",
    "@types/tinycolor2": "1.4.6",
    "@vitejs/plugin-react": "3.1.0",
    "@vitest/coverage-v8": "3.0.7",
    "@vitest/ui": "2.0.5",
    "ansicolor": "2.0.3",
    "autoprefixer": "10.4.7",
    "chai": "4.3.6",
    "cross-env": "7.0.3",
    "dotenv": "16.0.1",
    "esbuild": "0.19.10",
    "esbuild-sass-plugin": "2.16.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "3.3.1",
    "eslint-plugin-react": "7.32.2",
    "fake-indexeddb": "3.1.7",
    "fonteditor-core": "2.4.0",
    "harfbuzzjs": "0.3.6",
    "husky": "7.0.4",
    "jest-diff": "29.7.0",
    "jsdom": "22.1.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "playwright": "1.58.2",
    "postcss": "8.4.47",
    "prettier": "2.6.2",
    "rewire": "6.0.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "5.0.12",
    "vite-plugin-checker": "0.7.2",
    "vite-plugin-svgr": "4.2.0",
    "vitest": "3.0.6",
    "vitest-canvas-mock": "0.3.3",
    "wawoff2": "2.0.1",
    "which": "4.0.0"
  },
  "scripts": {
    "start": "vite --config excalidraw-app/vite.config.mts",
    "build:app": "cross-env VITE_APP_GIT_SHA=$GIT_SHA vite build --config excalidraw-app/vite.config.mts",
    "build:tauri": "cross-env VITE_APP_GIT_SHA=$GIT_SHA vite build --config excalidraw-app/vite.config.mts --mode tauri",
    "build:version": "node scripts/build-version.js excalidraw-app/build",
    "build": "pnpm build:tauri && pnpm build:version",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android build --apk --target aarch64 armv7",
    "test": "vitest",
    "test:app": "vitest",
    "test:update": "pnpm test:app --update --watch=false",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx .",
    "test:other": "pnpm prettier --list-different",
    "test:typecheck": "tsc",
    "test:all": "pnpm test:typecheck && pnpm test:code && pnpm test:other && pnpm test:app --watch=false",
    "test:coverage": "vitest --coverage",
    "fix:code": "pnpm test:code --fix",
    "fix:other": "pnpm prettier --write",
    "fix": "pnpm fix:other && pnpm fix:code",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore",
    "prepare": "husky install",
    "rm:build": "rimraf --glob excalidraw-app/build excalidraw-app/dist excalidraw-app/dev-dist",
    "rm:node_modules": "rimraf --glob node_modules excalidraw-app/node_modules",
    "clean-install": "pnpm rm:node_modules && pnpm install"
  }
}
